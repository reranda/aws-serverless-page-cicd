# After the first local bootstrap apply, copy this to backend.tf, fill the
# private bucket/account/key values, then terraform init -migrate-state.
terraform {
  backend "s3" {
    bucket       = "REPLACE_WITH_BOOTSTRAP_BUCKET"
    key          = "bootstrap/terraform.tfstate"
    region       = "eu-west-2"
    encrypt      = true
    kms_key_id   = "REPLACE_WITH_STATE_KEY_ARN"
    use_lockfile = true
  }
}
